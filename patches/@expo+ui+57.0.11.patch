   var onTap = EventDispatcher()
 }
 
+private enum DecodedImageCache {
+  static let shared: NSCache<NSString, UIImage> = {
+    let cache = NSCache<NSString, UIImage>()
+    cache.totalCostLimit = 64 * 1024 * 1024
+    return cache
+  }()
+
+  static func image(for source: String?) -> UIImage? {
+    guard let source, let url = URL(string: source) else {
+      return nil
+    }
+
+    let attributes = try? FileManager.default.attributesOfItem(atPath: url.path)
+    let size = (attributes?[.size] as? NSNumber)?.int64Value ?? 0
+    let modified = (attributes?[.modificationDate] as? Date)?.timeIntervalSinceReferenceDate ?? 0
+    let key = "\(url.absoluteString)@\(size):\(String(format: "%.6f", modified))" as NSString
+
+    if let cached = shared.object(forKey: key) {
+      return cached
+    }
+
+    guard let data = try? Data(contentsOf: url), let image = UIImage(data: data) else {
+      return nil
+    }
+
+    let pixels = image.size.width * image.scale * image.size.height * image.scale
+    shared.setObject(image, forKey: key, cost: Int(pixels) * 4)
+    return image
+  }
+}
+
