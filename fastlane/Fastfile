require "json"
require "securerandom"

platform :android do
  desc "Build a release APK"
  lane :apk do
    Bundler.with_original_env do
      Dir.chdir("..") { sh("npx", "expo", "prebuild", "--platform", "android") }
    end

    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: File.expand_path("../android", __dir__)
    )

    UI.success("APK ready: #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]}")
  end

  desc "Build a release AAB"
  lane :aab do
    UI.user_error!("Set ANDROID_RELEASE_STORE_FILE and friends in fastlane/.env first") unless ENV["ANDROID_RELEASE_STORE_FILE"]

    Bundler.with_original_env do
      Dir.chdir("..") { sh("npx", "expo", "prebuild", "--platform", "android") }
    end

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: File.expand_path("../android", __dir__)
    )

    UI.success("AAB ready: #{lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]}")
  end

  desc "Build and upload a release build to the Play Store closed testing track"
  lane :beta do
    UI.user_error!("Set ANDROID_RELEASE_STORE_FILE and friends in fastlane/.env first") unless ENV["ANDROID_RELEASE_STORE_FILE"]

    package_name = "app.reptikeep"
    track = "alpha"
    json_key_data = ENV["PLAY_JSON_KEY_CONTENT"]

    app_json_path = File.expand_path("../app.json", __dir__)
    app_json = JSON.parse(File.read(app_json_path))
    version = app_json["expo"]["version"]

    changelog_en = File.read(File.expand_path("metadata/android/en-US/release_notes/#{version}.txt", __dir__)).strip
    changelog_pt = File.read(File.expand_path("metadata/android/pt-BR/release_notes/#{version}.txt", __dir__)).strip
    [changelog_en, changelog_pt].each do |changelog|
      UI.user_error!("Android changelog for #{version} is #{changelog.length} chars, Play caps it at 500") if changelog.length > 500
    end

    latest_version_code = google_play_track_version_codes(
      package_name: package_name,
      track: track,
      json_key_data: json_key_data
    ).max
    next_version_code = latest_version_code + 1
    File.write(app_json_path, File.read(app_json_path).sub(/"versionCode":\s*\d+/, "\"versionCode\": #{next_version_code}"))

    File.write(File.expand_path("metadata/android/en-US/changelogs/#{next_version_code}.txt", __dir__), changelog_en)
    File.write(File.expand_path("metadata/android/pt-BR/changelogs/#{next_version_code}.txt", __dir__), changelog_pt)

    Bundler.with_original_env do
      Dir.chdir("..") { sh("npx", "expo", "prebuild", "--platform", "android") }
    end

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: File.expand_path("../android", __dir__)
    )

    upload_to_play_store(
      package_name: package_name,
      track: track,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key_data: json_key_data,
      release_status: "completed"
    )
  end
end

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: !ENV["ASC_KEY_CONTENT"].nil?
    )
  end

  private_lane :ci_keychain_password do
    password = SecureRandom.uuid
    create_keychain(
      name: "fastlane_tmp_keychain",
      password: password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )
    password
  end

  desc "Generate/fetch the Apple Distribution cert and provisioning profile via match"
  lane :certs do
    match(
      type: "appstore",
      api_key: asc_api_key,
      readonly: is_ci,
      keychain_name: is_ci ? "fastlane_tmp_keychain" : nil,
      keychain_password: is_ci ? ci_keychain_password : nil
    )
  end

  desc "Build and upload a release build to TestFlight"
  lane :beta do
    app_json_path = File.expand_path("../app.json", __dir__)
    app_json = JSON.parse(File.read(app_json_path))
    version = app_json["expo"]["version"]

    changelog_en = File.read(File.expand_path("metadata/ios/en-US/release_notes/#{version}.txt", __dir__)).strip
    changelog_pt = File.read(File.expand_path("metadata/ios/pt-BR/release_notes/#{version}.txt", __dir__)).strip

    api_key = asc_api_key

    latest_build = latest_testflight_build_number(api_key: api_key, app_identifier: "app.reptikeep", version: version)
    next_build = (latest_build + 1).to_s
    File.write(app_json_path, File.read(app_json_path).sub(/"buildNumber":\s*"\d+"/, "\"buildNumber\": \"#{next_build}\""))

    ios_dir = File.expand_path("../ios", __dir__)
    Bundler.with_original_env do
      Dir.chdir("..") { sh("npx", "expo", "prebuild", "--platform", "ios", "--no-install") }
      sh("pod", "install", "--project-directory=#{ios_dir}")
    end

    match(
      type: "appstore",
      api_key: api_key,
      readonly: is_ci,
      keychain_name: is_ci ? "fastlane_tmp_keychain" : nil,
      keychain_password: is_ci ? ci_keychain_password : nil
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.expand_path("../ios/ReptiKeep.xcodeproj", __dir__),
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["app.reptikeep"]
    )

    build_app(
      workspace: File.expand_path("../ios/ReptiKeep.xcworkspace", __dir__),
      scheme: "ReptiKeep",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      groups: ["Public Beta"],
      distribute_external: true,
      localized_build_info: {
        "en-US" => { whats_new: changelog_en },
        "pt-BR" => { whats_new: changelog_pt }
      }
    )
  end
end
